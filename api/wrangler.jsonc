{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sde-intern-task-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Single-origin deploy: the Worker serves the built SPA (web/dist) as static
  // assets and only runs Worker code for /api/* — so session cookies "just work"
  // with no CORS, same as the Vite proxy does in dev. Deep links (e.g. /dashboard)
  // fall back to index.html for client-side routing.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // D1 is our system of record. Surveys/questions/responses/answers are
  // relational and owner-scoped, so SQL beats KV blobs or R2 objects here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "survey_builder",
      "database_id": "cb552f78-dbb6-4fb6-89d6-2039278b91d5",
      "migrations_dir": "migrations"
    }
  ]
  // SESSION_SECRET (signing key for session cookies) is NOT defined here on
  // purpose: a plaintext `vars` value would override the real production secret
  // on every deploy. Instead:
  //   - Local dev: copy `.dev.vars.example` -> `.dev.vars` (wrangler dev loads it)
  //   - Production: `wrangler secret put SESSION_SECRET`
}
